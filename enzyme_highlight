library(readxl)
library(circlize)

# Import the Excel file
data <- read_excel("updated circle plot - glucose.xlsx")

# Convert Yes/No to numeric matrix
matrix_data <- as.matrix(data[, -1])
matrix_data[matrix_data == "Yes"] <- 1
matrix_data[matrix_data == "No"] <- 0
matrix_data <- apply(matrix_data, 2, as.numeric)
rownames(matrix_data) <- data$Target

# 1. Define gene groups
#tca_genes <- c("IDH3G","CS","IDH2","FH","IDH3A","PDHB","PDHA (PDHA1)", "MDH2","SDHA","IDH3B","PDHX","SUCLA2","ACO2")

glycolysis_genes <- c("ENO1","GAPDH","ALDOA","PKM","HK2","HK1",
                      "LDHB","LDHA","PKLR","PGM1","PGK2","GPI","PFKP")

#glutaminolysis_genes <- c("GLUD1","GLS","OGDH")

glucose_transport_genes <- c("GLUT2 (SLC2A2)","SGLT2 (SLC5A2)",
                             "GLUT1 (SLC2A1)","SGLT1 (SLC5A1)")

#glutamine_transport_genes <- c("SLC38A1","SLC38A2","SLC1A5","SLC38A3")

# 2. Define marker groups
activating_markers <- c("KDM4A", "KDM4C", "KDM6A (UTX)", "KDM6B (JMJD3)", "KMT2A (MLL1)", "KMT2B (MLL2)", "KMT2D (MLL4)", "KMT2F (SETD1A)", "ASH2L", "RBBP5")
repressing_markers <- c("KDM2B", "KDM1A (LSD1)", "KDM5A", "KDM5B", "KDM5C", "KDM5D", "EHMT2 (KMT1C)", "SETDB1")

# 3. Ordered data
ordered_sectors <- c(
  intersect(glycolysis_genes, rownames(matrix_data)),
  intersect(tca_genes, rownames(matrix_data)),
  intersect(glutaminolysis_genes, rownames(matrix_data)),
  intersect(glucose_transport_genes, rownames(matrix_data)),
  intersect(glutamine_transport_genes, rownames(matrix_data)),
  setdiff(rownames(matrix_data),
          c(glycolysis_genes,tca_genes,glutaminolysis_genes,
            glucose_transport_genes,glutamine_transport_genes)),
  intersect(activating_markers, colnames(matrix_data)),
  intersect(repressing_markers, colnames(matrix_data)),
  setdiff(colnames(matrix_data),
          c(activating_markers,repressing_markers))
)

# 4. Track colors
gene_colors <- c(
  rep("skyblue", length(glycolysis_genes)),
  rep("orchid", length(tca_genes)),
  rep("forestgreen", length(glutaminolysis_genes)),
  rep("gold", length(glucose_transport_genes)),
  rep("darkorange", length(glutamine_transport_genes))
)
names(gene_colors) <- c(glycolysis_genes,tca_genes,
                        glutaminolysis_genes,
                        glucose_transport_genes,
                        glutamine_transport_genes)

marker_track_colors <- c(
  rep("firebrick", length(activating_markers)),
  rep("navy", length(repressing_markers))
)
names(marker_track_colors) <- c(activating_markers,repressing_markers)

all_colors <- c(gene_colors, marker_track_colors)
missing <- setdiff(ordered_sectors, names(all_colors))
if(length(missing) > 0){
  all_colors <- c(all_colors, setNames(rep("grey", length(missing)), missing))
}
sector_colors <- all_colors[ordered_sectors]

# 5. Enzyme-based link colors (and highlight subset)
marker_chord_colors <- ifelse(colnames(matrix_data) %in% activating_markers, "firebrick",
                              ifelse(colnames(matrix_data) %in% repressing_markers, "navy", "grey"))
names(marker_chord_colors) <- colnames(matrix_data)

# SELECT WHICH MARKERS TO MAKE DARKER (bold)
highlight_markers <- c("RBBP5", "KMT2A (MLL1)", "KDM4A")  # <-- EDIT THIS

# Base color matrix: one color per column (marker) replicated down rows (genes)
base_col_mat <- matrix(rep(marker_chord_colors, each = nrow(matrix_data)),
                       nrow = nrow(matrix_data),
                       ncol = ncol(matrix_data),
                       dimnames = dimnames(matrix_data))

# Make all links light by embedding transparency in the colors
link_colors_matrix <- grDevices::adjustcolor(base_col_mat, alpha.f = 0.15)
link_colors_matrix <- matrix(link_colors_matrix,
                             nrow = nrow(matrix_data),
                             ncol = ncol(matrix_data),
                             dimnames = dimnames(matrix_data))

# Darken only the highlighted marker columns
keep_cols <- intersect(highlight_markers, colnames(matrix_data))
if(length(keep_cols) == 0){
  warning("No highlight_markers matched colnames(matrix_data). Check spelling/case.")
}
for(m in keep_cols){
  link_colors_matrix[, m] <- grDevices::adjustcolor(marker_chord_colors[m], alpha.f = 0.9)
}

# 6. Plot and save
#pdf("circle_plot_enzyme_highlight.pdf", width = 11, height = 10)
png("circle_plot_enzyme_highlight_update.png", width = 4000, height = 3000, res = 300)

circos.clear()

chordDiagram(matrix_data,
             grid.col = sector_colors,
             col = link_colors_matrix,
             order = ordered_sectors,
             transparency = 0,     # IMPORTANT: we already encoded alpha in colors
             link.border = NA,
             annotationTrack = "grid",
             preAllocateTracks = list(track.height = 0.2))

# Labels
circos.track(track.index = 1, panel.fun = function(x, y) {
  circos.text(CELL_META$xcenter, CELL_META$ylim[1], CELL_META$sector.index,
              facing = "clockwise", niceFacing = TRUE, adj = c(0, 0.5),cex=1.2)
}, bg.border = NA)

# Legend (simplified)
legend("bottomright",
       legend = c("Glycolysis",
                  "Glucose Transport",
                  "Activating Markers",
                  "Repressing Markers"),
       fill = c("skyblue", "gold", "firebrick", "navy"),
       cex = 1,
       bty = "n")

dev.off()

cat("Done. Saved: circle_plot_enzyme_highlight_update.pdf\n")
cat("Highlighted (darker) markers:", paste(keep_cols, collapse = ", "), "\n")
